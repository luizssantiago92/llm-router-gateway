# Local secrets
.env
.env.*
!.env.example

# Virtual environments
.venv/
venv/
env/

# Python bytecode and packaging
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
*.egg

# Test, coverage, type-checker, and linter caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.hypothesis/

# Local graph output (not part of the repo)
graphify-out/

# Editor and OS
.idea/
.vscode/
*.swp
.DS_Store

# retornatus-gitignore:begin
# Local index and cache. Canonical Retornatus artifacts stay tracked.
.retornatus/index/
.retornatus/runtime/
# Private keys and local env files. Public keys stay tracked.
*.pem
*.key
.env
.env.*
!.env.example
!.retornatus/keys/*.pub
# retornatus-gitignore:end
